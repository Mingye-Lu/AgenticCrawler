---
// Starlight's site title with the hanging spider in place of the logo image,
// so the docs header matches the landing page.
import Spider from './Spider.astro';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	<Spider />
	<span translate="no">{siteTitle}</span>
</a>

<style>
	.site-title {
		--spider-gap: calc((var(--sl-nav-height) - 1.9rem) / 2);
		align-items: center;
		gap: var(--sl-nav-gap);
		font-size: var(--sl-text-h4);
		color: var(--sl-color-text-accent);
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}

	span {
		overflow: hidden;
	}
</style>
